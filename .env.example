# =====================================================
# OVARA ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# =====================================================

# =====================================================
# SUPABASE CONFIGURATION
# =====================================================
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_for_backend_only

# =====================================================
# STRIPE CONFIGURATION
# =====================================================
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Price IDs (create these in your Stripe Dashboard)
# Basic Tier
VITE_STRIPE_BASIC_MONTHLY_PRICE_ID=price_basic_monthly_id
VITE_STRIPE_BASIC_YEARLY_PRICE_ID=price_basic_yearly_id

# Pro Tier
VITE_STRIPE_PRO_MONTHLY_PRICE_ID=price_pro_monthly_id
VITE_STRIPE_PRO_YEARLY_PRICE_ID=price_pro_yearly_id

# Premium Tier
VITE_STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_premium_monthly_id
VITE_STRIPE_PREMIUM_YEARLY_PRICE_ID=price_premium_yearly_id

# =====================================================
# AI API KEYS
# =====================================================
# OpenAI (for GPT-4 essay generation, chat)
VITE_OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_ORGANIZATION=org-your_org_id_optional

# Anthropic Claude (for humanization)
VITE_ANTHROPIC_API_KEY=sk-ant-your_anthropic_key

# AI Detection API (choose one)
GPTZERO_API_KEY=your_gptzero_api_key
ORIGINALITY_API_KEY=your_originality_api_key

# Plagiarism Detection
COPYSCAPE_USERNAME=your_copyscape_username
COPYSCAPE_API_KEY=your_copyscape_api_key

# Grammar Checking
LANGUAGETOOL_API_KEY=your_languagetool_key

# =====================================================
# EMAIL SERVICE (SendGrid)
# =====================================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@ovara.app
SENDGRID_FROM_NAME=Ovara

# =====================================================
# SECURITY & RATE LIMITING
# =====================================================
JWT_SECRET=your_very_long_random_jwt_secret_at_least_32_chars
JWT_REFRESH_SECRET=another_very_long_random_refresh_secret
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =====================================================
# APPLICATION SETTINGS
# =====================================================
NODE_ENV=development
VITE_APP_URL=http://localhost:5173
PRODUCTION_URL=https://ovara.app

# Feature Flags
ENABLE_DISCORD_BOT=true
ENABLE_BROWSER_EXTENSION=true
MAINTENANCE_MODE=false

# =====================================================
# TIER LIMITS (per month)
# =====================================================
TIER_BASIC_WORDS=50000
TIER_BASIC_AI_SCANS=20
TIER_BASIC_ESSAYS=10

TIER_PRO_WORDS=150000
TIER_PRO_AI_SCANS=100
TIER_PRO_ESSAYS=50

TIER_PREMIUM_WORDS=300000
TIER_PREMIUM_AI_SCANS=999999
TIER_PREMIUM_ESSAYS=999999
